# Copy to .env and fill in. .env is gitignored — never commit a real token.

# Needed to download the gated mitulshah/transaction-categorization dataset.
# Get one at https://huggingface.co/settings/tokens (Read access is enough),
# after accepting the dataset's access conditions at
# https://huggingface.co/datasets/mitulshah/transaction-categorization
HF_TOKEN=

# Needed to download the BharatPOI dataset (real Indian business names +
# categories, used as supplementary training data — see
# real_merchant_vocabulary.py). Get one at kaggle.com -> account settings
# -> "Create New Token". Newer Kaggle tokens look like "KGAT_...".
KAGGLE_API_TOKEN=
