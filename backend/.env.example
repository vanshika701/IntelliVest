# Copy this file to .env and fill in real values. .env is gitignored —
# never commit real secrets.

APP_NAME="IntelliVest AI"
ENVIRONMENT=development
LOG_LEVEL=INFO

MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=intellivest

# Set to false to disable the background ingestion scheduler (e.g. if you
# just want the API up without it hitting external APIs on a timer)
ENABLE_SCHEDULER=true

# JSON array of allowed frontend origins for CORS
CORS_ORIGINS=["http://localhost:5173"]

# External API keys (needed from Phase 1 onward — leave blank until then)
NEWS_API_KEY=
ALPHA_VANTAGE_API_KEY=
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=
