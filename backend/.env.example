# Copy this file to .env and fill in real values. .env is gitignored —
# never commit real secrets.

APP_NAME="IntelliVest AI"
ENVIRONMENT=development
LOG_LEVEL=INFO

MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=intellivest

# Set to false to disable the background ingestion scheduler (e.g. if you
# just want the API up without it hitting external APIs on a timer)
ENABLE_SCHEDULER=true

# JSON array of allowed frontend origins for CORS
CORS_ORIGINS=["http://localhost:5173"]

# JWT auth (Phase 2). Generate a real secret for anything beyond local
# dev: python3 -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=CHANGE-ME-IN-PRODUCTION-USE-A-REAL-SECRET
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440

# External API keys (needed from Phase 1 onward — leave blank until then)
ALPHA_VANTAGE_API_KEY=
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=

# News summaries (Phase 5). "extractive" = classical baseline (default);
# "ml" = our trained model (placeholder until it's ready).
SUMMARIZER_PROVIDER=extractive
SUMMARIZER_MAX_WORDS=100
SUMMARIZER_CACHE_TTL_MIN=60
# Model server for SUMMARIZER_PROVIDER=ml (unused until then), e.g. http://localhost:8100
ML_SUMMARIZER_URL=
# Append article text + summary pairs to data/summarization_log.jsonl (gitignored)
LOG_SUMMARIES=false

# Budget explanations (Phase 8). "template" = built-in sentences (default,
# works offline); "anthropic" = Claude rephrases the engine's computed output
# (requires `pip install anthropic` and ANTHROPIC_API_KEY). The LLM never
# computes numbers or categorises; replies that change numbers are discarded.
BUDGET_EXPLAINER_PROVIDER=template
BUDGET_EXPLAINER_MODEL=claude-opus-5-5
ANTHROPIC_API_KEY=
