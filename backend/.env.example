# Copy this file to .env and fill in real values. .env is gitignored —
# never commit real secrets.

APP_NAME="IntelliVest AI"
ENVIRONMENT=development
LOG_LEVEL=INFO

MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=intellivest

# Set to false to disable the background ingestion scheduler (e.g. if you
# just want the API up without it hitting external APIs on a timer)
ENABLE_SCHEDULER=true

# JSON array of allowed frontend origins for CORS
CORS_ORIGINS=["http://localhost:5173"]

# JWT auth (Phase 2). Generate a real secret for anything beyond local
# dev: python3 -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=CHANGE-ME-IN-PRODUCTION-USE-A-REAL-SECRET
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440

# External API keys (needed from Phase 1 onward — leave blank until then)
ALPHA_VANTAGE_API_KEY=
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=

# News sentiment (Phase 5). The default model, then the others users can pick
# on the instrument page (comma-separated). Each one scores every article.
SENTIMENT_MODEL=mrm8488/distilroberta-finetuned-financial-news-sentiment-analysis
SENTIMENT_EXTRA_MODELS=ProsusAI/finbert

# News summaries (Phase 5): the default summarizer. Users can pick any of
# t5-small (default, best in our comparison), extractive, distilbart,
# bart-large-cnn, pegasus-financial. "ml" = a model server (placeholder).
SUMMARIZER_PROVIDER=t5-small
SUMMARIZER_MAX_WORDS=100
SUMMARIZER_CACHE_TTL_MIN=60
# Model server for SUMMARIZER_PROVIDER=ml (unused until then), e.g. http://localhost:8100
ML_SUMMARIZER_URL=
# Append article text + summary pairs to data/summarization_log.jsonl (gitignored)
LOG_SUMMARIES=false

# Stock predictors (Phase 4). Relative to the repo root.
# LightGBM (3.0.0), made by ml/train_stock_predictor.py:
STOCK_PREDICTOR_PATH=ml/models/stock_predictor/model.joblib
# LSTM + LightGBM ensemble (4.0.0), made by ml/train_hybrid_lstm_lightgbm.py --final:
STOCK_PREDICTOR_ENSEMBLE_PATH=ml/models/stock_predictor_hybrid/model.joblib
# Default for users who don't pick one: lstm_lgbm or lgbm.
PREDICTION_MODEL=lstm_lgbm

# Budget explanations (Phase 8). "template" = built-in sentences (default,
# works offline); "groq" / "gemini" = that LLM rephrases them, once its key is
# set (free keys: console.groq.com/keys, aistudio.google.com/apikey). The LLM
# never computes numbers or categorises; replies that change numbers are
# discarded. Leave the model empty for the provider's default.
BUDGET_EXPLAINER_PROVIDER=template
BUDGET_EXPLAINER_MODEL=
GROQ_API_KEY=
GEMINI_API_KEY=

# Blockchain (Phase 10). Off by default. Test networks only: 31337 (local
# Hardhat), 11155111 (Sepolia) or 80002 (Amoy). When on, every key below is
# required and all must differ. Locally, use accounts printed by `npm run node`;
# those keys are public, so the app refuses them on any other network.
BLOCKCHAIN_ENABLED=false
BLOCKCHAIN_RPC_URL=http://127.0.0.1:8545
BLOCKCHAIN_CHAIN_ID=31337
BLOCKCHAIN_DEPLOYMENT_PATH=blockchain/deployments/local.json
# These three only sign and need no ETH
BLOCKCHAIN_SENTIMENT_PRIVATE_KEY=
BLOCKCHAIN_STOCK_PRIVATE_KEY=
BLOCKCHAIN_ADVISOR_PRIVATE_KEY=
# These two send transactions and need test ETH
BLOCKCHAIN_RELAYER_PRIVATE_KEY=
BLOCKCHAIN_SIP_RUNNER_PRIVATE_KEY=
# Registered model versions (scripts/register_models.py prints them)
BLOCKCHAIN_SENTIMENT_MODEL_VERSION=
BLOCKCHAIN_STOCK_MODEL_VERSION=
# Event reader: blocks to wait (use 3 or more on Sepolia) and where to start
BLOCKCHAIN_CONFIRMATIONS=0
BLOCKCHAIN_START_BLOCK=0
